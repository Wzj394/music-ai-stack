# 统一换行符，避免跨平台差异
* text=auto eol=lf

# 明确指定
*.md    text eol=lf
*.py    text eol=lf
*.lua   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.wav   binary
*.flac  binary
*.mp3   binary
*.mid   binary
*.pt    binary
*.onnx  binary
*.safetensors binary
